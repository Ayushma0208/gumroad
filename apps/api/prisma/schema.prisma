generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  CREATOR
  ADMIN
}

enum ProductType {
  DIGITAL_DOWNLOAD
  COURSE
  TEMPLATE
  BUNDLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Currency {
  USD
  INR
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ReportTargetType {
  PRODUCT
  REVIEW
  CREATOR
}

enum ReportReason {
  COPYRIGHT
  SPAM
  HARASSMENT
  MISLEADING
  INAPPROPRIATE
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum AdminAuditAction {
  USER_SUSPENDED
  USER_RESTORED
  PRODUCT_PUBLISHED
  PRODUCT_UNPUBLISHED
  PRODUCT_ARCHIVED
  PRODUCT_RESTORED
  REVIEW_HIDDEN
  REVIEW_RESTORED
  REVIEW_DELETED
  REPORT_UNDER_REVIEW
  REPORT_RESOLVED
  REPORT_DISMISSED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  CREATOR_SUSPENDED
  CREATOR_RESTORED
  PAYOUT_MARKED_PROCESSING
  PAYOUT_MARKED_PAID
  PAYOUT_MARKED_FAILED
  PAYOUT_ACCOUNT_VERIFIED
  PAYOUT_ACCOUNT_DISABLED
}

enum CreatorEarningStatus {
  PENDING
  AVAILABLE
  RESERVED
  PAID
  REVERSED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayoutProvider {
  /// Ops settles outside the app (bank transfer / manual). No simulated auto-pay.
  MANUAL_REVIEW
}

enum PayoutAccountStatus {
  NOT_CONFIGURED
  PENDING_REVIEW
  VERIFIED
  DISABLED
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  passwordHash   String
  role           Role       @default(CUSTOMER)
  status         UserStatus @default(ACTIVE)
  /// Bumped on password change, account close, and admin suspend to invalidate JWTs.
  sessionVersion Int        @default(0)
  avatarUrl      String?
  avatarPublicId String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  creatorProfile    CreatorProfile?
  cart              Cart?
  orders            Order[]
  purchases         Purchase[]
  reviews           Review[]
  downloads         Download[]
  wishlistItems     WishlistItem[]
  couponRedemptions CouponRedemption[]
  reportsFiled      Report[]           @relation("ReporterReports")
  reportsResolved   Report[]           @relation("ResolverReports")
  auditLogs         AdminAuditLog[]
  notifications     Notification[]
  notificationPreference NotificationPreference?
  emailJobs         EmailJob[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([role, createdAt])
}

model CreatorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  storeName      String
  slug           String   @unique
  bio            String
  description    String?
  avatar         String?
  avatarPublicId String?
  banner         String?
  bannerPublicId String?
  website        String?
  instagram      String?
  twitter        String?
  linkedin       String?
  youtube        String?
  github         String?
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products      Product[]
  reviewReplies ReviewReply[]
  coupons       Coupon[]
  earnings      CreatorEarning[]
  payouts       Payout[]
  payoutAccount CreatorPayoutAccount?

  @@index([slug])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  label       String
  description String
  imageUrl    String
  icon        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@index([sortOrder])
}

model Product {
  id                String        @id @default(cuid())
  creatorId         String
  creator           CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title             String
  slug              String        @unique
  shortDescription  String
  description       String
  price             Int
  currency          Currency      @default(USD)
  productType       ProductType
  status            ProductStatus @default(DRAFT)
  coverImage        String
  featured          Boolean       @default(false)
  trending          Boolean       @default(false)
  editorsPick       Boolean       @default(false)
  /// Named product-page preset. Unused until pageStyle is set.
  pageTemplateId    String        @default("classic")
  /// Product-page tokens. Null means the original Lumen product page.
  pageStyle         Json?
  /// Checkout tokens (layout, fonts, corners, palette). Seller-only for now.
  checkoutStyle     Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  images        ProductImage[]
  files         ProductFile[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  purchases     Purchase[]
  reviews       Review[]
  downloads     Download[]
  wishlistItems WishlistItem[]
  couponProducts CouponProduct[]
  earnings       CreatorEarning[]

  @@index([creatorId])
  @@index([categoryId])
  @@index([slug])
  @@index([status])
  @@index([productType])
  @@index([price])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, categoryId])
  @@index([status, featured])
  /// Discover trending sort: published + trending flag, then sales.
  @@index([status, trending])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  publicId  String
  url       String
  width     Int?
  height    Int?
  format    String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([publicId])
}

model ProductFile {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  fileName     String
  publicId     String
  resourceType String     @default("raw")
  format       String     @default("")
  fileSize     Int
  mimeType     String
  version      Int?
  isPrivate    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  downloads    Download[]

  @@index([productId])
  @@index([publicId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([userId, createdAt])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Order {
  id          String      @id @default(cuid())
  customerId  String
  customer    User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subtotal    Int         @default(0)
  discount    Int         @default(0)
  totalAmount Int
  currency    Currency
  status      OrderStatus @default(PENDING)
  checkoutKey String?
  couponId    String?
  couponCode  String?
  coupon      Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items       OrderItem[]
  payment     Payment?
  purchases   Purchase[]
  downloads   Download[]
  reviews     Review[]
  couponRedemption CouponRedemption?
  earnings         CreatorEarning[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerId, status])
  @@index([customerId, createdAt])
  @@index([checkoutKey])
  @@index([couponId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  creatorId    String
  productTitle String  @default("")
  price        Int
  quantity     Int     @default(1)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  earning      CreatorEarning?

  @@index([orderId])
  @@index([productId])
  @@index([creatorId])
  @@index([creatorId, productId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @unique
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  providerPaymentId String?         @unique
  providerOrderId   String?         @unique
  amount            Int
  currency          Currency
  status            PaymentStatus   @default(PENDING)
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([providerOrderId])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  productId String
  orderId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
}

model Download {
  id            String      @id @default(cuid())
  userId        String
  productId     String
  productFileId String
  orderId       String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  productFile   ProductFile @relation(fields: [productFileId], references: [id], onDelete: Restrict)
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([productId])
  @@index([productFileId])
  @@index([orderId])
  @@index([userId, createdAt])
}

model Review {
  id        String       @id @default(cuid())
  productId String
  userId    String
  orderId   String?
  rating    Int
  title     String
  comment   String
  status    ReviewStatus @default(PUBLISHED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reply     ReviewReply?

  @@unique([userId, productId])
  @@index([productId])
  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([productId, status])
  @@index([createdAt])
}

model ReviewReply {
  id        String         @id @default(cuid())
  reviewId  String         @unique
  creatorId String
  comment   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  review    Review         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  @@index([creatorId])
}

model Coupon {
  id             String         @id @default(cuid())
  /// Null reserved for future platform-wide coupons; creator coupons always set this.
  creatorId      String?
  creator        CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  code           String         @unique
  type           CouponType
  /// PERCENTAGE: 1–100. FIXED: minor currency units (cents/paise).
  value          Int
  /// Cap for percentage discounts (minor units). Null = uncapped.
  maxDiscount    Int?
  /// Minimum eligible subtotal in minor units.
  minOrderAmount Int?
  maxUses        Int?
  usedCount      Int            @default(0)
  perUserLimit   Int?
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  products       CouponProduct[]
  redemptions    CouponRedemption[]
  orders         Order[]

  @@index([creatorId])
  @@index([isActive])
  @@index([expiresAt])
  @@index([creatorId, isActive])
}

model CouponProduct {
  id        String  @id @default(cuid())
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([couponId, productId])
  @@index([productId])
  @@index([couponId])
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String   @unique
  discountAmount Int
  createdAt      DateTime @default(now())
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
  @@index([createdAt])
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String
  reporter       User             @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType     ReportTargetType
  targetId       String
  reason         ReportReason
  description    String?
  status         ReportStatus     @default(OPEN)
  resolvedById   String?
  resolvedBy     User?            @relation("ResolverReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([createdAt])
}

model AdminAuditLog {
  id         String           @id @default(cuid())
  adminId    String
  admin      User             @relation(fields: [adminId], references: [id], onDelete: Restrict)
  action     AdminAuditAction
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime         @default(now())

  @@index([adminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum NotificationType {
  PURCHASE_SUCCESS
  CREATOR_SALE
  REVIEW_RECEIVED
  PRODUCT_APPROVED
  PRODUCT_UNPUBLISHED
  PRODUCT_ARCHIVED
  ACCOUNT_UPDATE
  PAYOUT_REQUESTED
  PAYOUT_PAID
  PAYOUT_FAILED
  PAYOUT_ACCOUNT_UPDATE
}

enum EmailJobStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

enum EmailTemplate {
  PURCHASE_CONFIRMATION
  CREATOR_SALE
  REVIEW_RECEIVED
  PRODUCT_STATUS
  PAYOUT_REQUESTED
  PAYOUT_PAID
  PAYOUT_FAILED
  PAYOUT_ACCOUNT_UPDATE
}

/// Append-mostly creator earnings ledger row (one SALE credit per paid OrderItem).
model CreatorEarning {
  id                   String               @id @default(cuid())
  creatorId            String
  creator              CreatorProfile       @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  orderId              String
  order                Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId          String               @unique
  orderItem            OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  productId            String
  product              Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  currency             Currency
  grossAmountCents     Int
  discountAmountCents  Int
  netSalesCents        Int
  platformFeeCents     Int
  /// Fee rate snapshot at posting time (basis points). History stays correct if config changes.
  platformFeeBps       Int
  processingFeeCents   Int                  @default(0)
  creatorAmountCents   Int
  status               CreatorEarningStatus
  availableAt          DateTime
  /// Deterministic idempotency: earning:orderItem:{orderItemId}
  ledgerKey            String               @unique
  reversesEarningId    String?
  reversesEarning      CreatorEarning?      @relation("EarningReversals", fields: [reversesEarningId], references: [id], onDelete: Restrict)
  reversedBy           CreatorEarning[]     @relation("EarningReversals")
  payoutItem           PayoutItem?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([creatorId, createdAt])
  @@index([creatorId, status])
  @@index([orderId])
  @@index([productId])
  @@index([creatorId, status, availableAt])
  @@index([availableAt])
}

/// Minimal payout profile metadata — never store bank passwords / CVV / full credentials.
model CreatorPayoutAccount {
  id                 String              @id @default(cuid())
  creatorId          String              @unique
  creator            CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  status             PayoutAccountStatus @default(NOT_CONFIGURED)
  provider           PayoutProvider      @default(MANUAL_REVIEW)
  accountHolderName  String?
  /// Masked display hint only (e.g. last 4), never full account numbers when avoidable.
  accountHint        String?
  providerAccountId  String?
  verifiedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Payout {
  id               String         @id @default(cuid())
  creatorId        String
  creator          CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  amountCents      Int
  currency         Currency
  status           PayoutStatus
  provider         PayoutProvider @default(MANUAL_REVIEW)
  providerPayoutId String?        @unique
  failureCode      String?
  failureMessage   String?
  idempotencyKey   String         @unique
  requestedAt      DateTime       @default(now())
  processedAt      DateTime?
  items            PayoutItem[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([creatorId, createdAt])
  @@index([creatorId, status])
  @@index([status, createdAt])
}

model PayoutItem {
  id          String         @id @default(cuid())
  payoutId    String
  payout      Payout         @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  earningId   String         @unique
  earning     CreatorEarning @relation(fields: [earningId], references: [id], onDelete: Restrict)
  amountCents Int
  createdAt   DateTime       @default(now())

  @@index([payoutId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  data      Json?
  /// Deterministic key to prevent duplicate notifications for the same event.
  eventKey  String?          @unique
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([type])
  @@index([createdAt])
}

model NotificationPreference {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Marketing / promotional (off by default).
  marketingEmailEnabled    Boolean  @default(false)
  /// Optional toggles for non-essential transactional categories.
  purchaseEmails           Boolean  @default(true)
  creatorSaleEmails        Boolean  @default(true)
  reviewEmails             Boolean  @default(true)
  productModerationEmails  Boolean  @default(true)
  /// Always treated as required when sending; stored for UI transparency.
  securityEmails           Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model EmailJob {
  id            String         @id @default(cuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  type          String
  toEmail       String
  subject       String
  template      EmailTemplate
  payload       Json
  status        EmailJobStatus @default(PENDING)
  attempts      Int            @default(0)
  maxAttempts   Int            @default(3)
  lastError     String?
  /// Deterministic key preventing duplicate transactional emails.
  eventKey      String         @unique
  nextAttemptAt DateTime       @default(now())
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}
