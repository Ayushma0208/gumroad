# PostgreSQL
DATABASE_URL="postgresql://lumen:lumen@localhost:5432/lumen"

# HTTP
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"
# Public app URL used in email links (defaults to CLIENT_URL)
APP_URL="http://localhost:3000"

# Auth (httpOnly cookie + JWT). Use a long random string (≥32 chars) in any shared environment.
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Prefer shorter sessions in production (e.g. 7d). sessionVersion invalidates on password change.
JWT_EXPIRES_IN="7d"
COOKIE_NAME="lumen_session"
# Prefer lax with same-origin Next proxy. Use none only for cross-site API + CSRF header.
COOKIE_SAME_SITE="lax"

# Email — console logs in development; set EMAIL_PROVIDER=resend + EMAIL_API_KEY in production
EMAIL_PROVIDER="console"
EMAIL_FROM="Lumen <noreply@example.com>"
EMAIL_API_KEY=""
EMAIL_WORKER_INTERVAL_MS=15000

# Payments (Razorpay). Webhook secret is optional; omit it to skip webhooks.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Storage (Cloudinary) — private digital files use signed delivery
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
MAX_PRODUCT_FILE_SIZE_MB=100
MAX_PRODUCT_IMAGE_SIZE_MB=10
CLOUDINARY_DOWNLOAD_TTL_SECONDS=120

# Creator earnings / payouts
# PLATFORM_FEE_BPS: 100 = 1%. Default 0 until business sets a take rate.
PLATFORM_FEE_BPS=0
# Hours before PENDING earnings become AVAILABLE (default 7 days).
PAYOUT_HOLDING_PERIOD_HOURS=168
# Minimum payout request in minor units (cents/paise).
MIN_PAYOUT_AMOUNT_CENTS=1000
