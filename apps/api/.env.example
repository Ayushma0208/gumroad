# PostgreSQL
DATABASE_URL="postgresql://lumen:lumen@localhost:5432/lumen"

# HTTP
PORT=4000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# Auth (httpOnly cookie + JWT). Use a long random string in any shared environment.
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="30d"
COOKIE_NAME="lumen_session"

# Optional — not used yet. Do not put real secrets in git.
REDIS_URL="redis://localhost:6379"

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
S3_BUCKET=""
S3_PUBLIC_BASE_URL=""

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
