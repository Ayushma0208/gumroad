{
  "name": "lumen",
  "private": true,
  "version": "0.1.0",
  "description": "Lumen — a premium creator commerce platform",
  "scripts": {
    "dev": "pnpm --filter @lumen/web dev",
    "dev:web": "pnpm --filter @lumen/web dev",
    "dev:api": "pnpm --filter @lumen/api dev",
    "build": "pnpm --filter @lumen/web build",
    "lint": "pnpm --filter @lumen/web lint && pnpm --filter @lumen/api lint",
    "typecheck": "pnpm --filter @lumen/web typecheck && pnpm --filter @lumen/api typecheck",
    "test:api": "pnpm --filter @lumen/api test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
